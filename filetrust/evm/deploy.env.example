# FileTrust — deployment environment template.
#
# Copy to deploy.env, edit, then:
#   set -a; . ./deploy.env; set +a
#   npm run deploy
#   npm run manifest
#
# Every variable below is optional: deploy_filetrust.js applies the same default
# shown here when the variable is unset. They are listed so a production deploy is
# an explicit, reviewable document rather than a set of implicit defaults.

# ── Chain connection ────────────────────────────────────────────────────────
# The Cosmos EVM JSON-RPC endpoint started by scripts/local_filetrust_node.sh.
FILETRUST_COSMOS_RPC_URL=http://127.0.0.1:8545
# Fixed gas price in aftu. 1,000,000 is the chain's genesis base fee and floor.
# The fee market only moves when a block exceeds its gas target (25M of a 100M
# block), which a deployment does not reach — but if the chain is busy, raise this
# above the current base fee or the deploy transactions will be rejected as
# underpriced part-way through.
FILETRUST_FIXED_GAS_PRICE_WEI=1000000

# ── Storage-proof circuit shape ─────────────────────────────────────────────
# These must match the prover binaries the VaultKeepers actually run. The stack
# runner uses 512/26 with the 512-byte partition verifier.
STORAGEPROOF_ZK_BLOCK_SIZE=512
STORAGEPROOF_ZK_TREE_DEPTH=26
STORAGE_PROOF_PARTITION_GENERATED_VERIFIER_CONTRACT=contracts/PartitionStorageProofGnarkVerifier512.sol:Verifier
PARTITION_CIRCUIT_SECTORS=16
PARTITION_CIRCUIT_CHALLENGES=4

# ── Storage-proof timing ────────────────────────────────────────────────────
# STORAGEPROOF_DEADLINE_COUNT also sizes the G.1A certification ring:
#   slotSeconds = STORAGE_PROOF_PERIOD_SECONDS / STORAGEPROOF_DEADLINE_COUNT
#   ringSize    = ceil(CAPACITY_MAX_PROOF_AGE_SECONDS / slotSeconds) + 2   (max 256)
# The ring is immutable after deployment; changing these later needs a redeploy.
STORAGE_PROOF_PERIOD_SECONDS=86400
STORAGE_PROOF_DEADLINE_SECONDS=21600
STORAGE_PROOF_MAX_CHALLENGES=4
STORAGEPROOF_DEADLINE_COUNT=48
CAPACITY_MAX_PROOF_AGE_SECONDS=108000
CAPACITY_MAX_MANIFEST_OVERHEAD_BYTES=18446744073709551615

# ── Registry and admission ──────────────────────────────────────────────────
# Headroom a VaultKeeper must keep beyond its certified capacity (100 MiB).
ADMISSION_MARGIN_BYTES=104857600
STORAGE_REGISTRATION_TIMEOUT_SECONDS=600
# Minimum stake (FTU) for a Guardian and, through StakingManager, a VaultKeeper.
MIN_GUARDIAN_STAKE=1

# ── Economics ───────────────────────────────────────────────────────────────
# Wei paid per Service Unit. Repricing after launch goes through the timelock;
# see scripts/update_su_rate_from_price.py at the repository root.
SU_TO_WEI_RATE=1000000000000

# ── Guardian penalties ──────────────────────────────────────────────────────
# Amounts in aftu, the 18-decimal unit of FTU (1 FTU = 10^18 aftu). Each must be
# at most 1% of MIN_GUARDIAN_STAKE (0.01 FTU = 10000000000000000 aftu for the
# default 1 FTU); a larger or malformed value stops the deployment before its
# first transaction. A Guardian is charged at most 1% of the minimum stake it
# was admitted with. Changes after launch go through the timelock.
# Slashed per missed share-proof epoch (0.001 FTU): 10% to an independent
# reporter, 90% to the treasury; a Guardian's own report pays the treasury all.
MISSED_EPOCH_PENALTY_WEI=1000000000000000
# Fined per verified DKG complaint (0.001 FTU), to the treasury. The fine counts
# toward the same complaint's penalty points, so a complaint costs the larger of
# its fine and its points, never both.
VERIFIED_DKG_COMPLAINT_SLASH_WEI=1000000000000000

# ── VaultKeeper wrong-proof slash rates ─────────────────────────────────────
# Basis points of the stake (100 = 1%) taken at the slash and the suspension
# level of the wrong-proof escalation. Each at most 5000, so one wrong proof
# never takes more than half the stake, and the suspension rate not below the
# slash rate; checked before the first transaction.
WRONG_PROOF_SLASH_BPS=50
WRONG_PROOF_SUSPEND_SLASH_BPS=200

# ── Guardian DKG profiles ───────────────────────────────────────────────────
ZKDKG_SUPPORTED_N=3,5,7,10,15,20
ZKDKG_SUPPORTED_PROFILES=shipped

# ── Governance ──────────────────────────────────────────────────────────────
# Timelock minimum delay in seconds (48 h). Every privileged contract is handed
# to this timelock at the end of deployment; see ../architecture/GOVERNANCE.md.
GOVERNANCE_DELAY_SECONDS=172800
# local (default): unset values fall back to local defaults -- deployer account 0
# proposes, execution stays open, no separate canceller, and the timelock is the
# treasury. mainnet: no defaults; the deployment stops before its first
# transaction unless the treasury contract, the proposer multisig and an
# independent canceller are set, none of them the deployer.
#FILETRUST_DEPLOY_PROFILE=mainnet
#FILETRUST_TREASURY_ADDRESS=
#GOVERNANCE_PROPOSER_ADDRESS=
#GOVERNANCE_CANCELLER_ADDRESS=
#GOVERNANCE_EXECUTOR_ADDRESS=

# ── Deployment signing and allowance ────────────────────────────────────────
# Set these explicitly before deploying. The key file must be outside Git,
# owned by the deploying user, and mode 0600. No key value belongs in this file.
FILETRUST_DEPLOY_KEY_FILE=
# Required maximum total debit, in aftu. Choose and review your own allowance.
FILETRUST_DEPLOY_MAX_DEBIT_WEI=
