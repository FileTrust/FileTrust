pragma solidity ^0.8.37;

import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";

/// @notice Ownable2Step without renouncing. A transfer names the next owner and only
///         that owner's acceptOwnership completes it, so control cannot be handed to an
///         address that cannot act -- for the timelock the acceptance is itself a
///         timelock operation. Renouncing is refused: an ownerless contract could never
///         again revoke a compromised slasher or rewarder.
abstract contract FileTrustOwnable is Ownable2Step {
    error OwnershipCannotBeRenounced();

    function renounceOwnership() public pure override {
        revert OwnershipCannotBeRenounced();
    }
}
