pragma solidity ^0.8.37;

/// @notice Generic verifier interface used by StorageProofSC.
/// The concrete implementation can wrap a Groth16/Plonk verifier generated
/// from the chosen FileTrust storage-proof circuit.
interface IStorageProofVerifier {
    function verifyProof(bytes calldata proof, uint256[] calldata publicInputs) external view returns (bool);
}
